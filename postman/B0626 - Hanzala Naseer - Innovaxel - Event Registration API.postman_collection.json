        {
          "name": "Current Date/Time Exactly",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date();\r",
                  "const formattedDate = today.toISOString().split(\"T\")[0];\r",
                  "\r",
                  "pm.environment.set(\"currentDate\", formattedDate);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"React Workshop\",\r\n    \"totalSeats\": 30,\r\n    \"eventDate\": \"{{currentDate}}\"\r\n}\r\n   \r\n",
